# Copy to .env.local to point at a different Supabase project. Both values are
# safe to ship to browsers: row-level security in the database is what
# protects the data.
#
# Left empty, the app uses the live Pookies project (src/lib/data/supabase/project.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "sample" to use built-in sample teammates instead, with no backend.
NEXT_PUBLIC_DATA_SOURCE=
