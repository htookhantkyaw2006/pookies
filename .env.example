# Copy to .env.local and fill in. Both values are safe to ship to browsers:
# row-level security in the database is what protects the data.
#
# Leave them empty to run on built-in sample teammates with no backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to "sample" to force the sample office even when the two
# values above are filled in.
NEXT_PUBLIC_DATA_SOURCE=
